{
  "name": "dsh-vmic",
  "version": "1.0.0",
  "description": "Voice input plugin for DeepSeek Harness: a mic button in the chat composer with real-time spectrum animation, 16kHz WAV recording, ASR via pluggable providers (Xiaomi MiMo, Volcengine Doubao live streaming), optional LLM polish, all proxied through same-origin host routes.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "voice-input",
    "asr",
    "speech-to-text",
    "xiaomi-mimo",
    "volcengine-doubao"
  ],
  "author": "Calvin",
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  }
}
